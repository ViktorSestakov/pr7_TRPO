<Window x:Class="pr7_shestakov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Питомцы — клиент REST API" Width="1280" Height="860"
        MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen"
        Style="{StaticResource MaterialDesignWindow}" FontFamily="Segoe UI"
        Background="#F3F6F8" TextElement.Foreground="#203536" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#123F3D" Padding="28,18">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#285450" CornerRadius="14" Padding="14,7"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" FontSize="12" />
                </Border>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Paw" Width="32" Height="32" Foreground="#93D6C6"
                                             VerticalAlignment="Center" Margin="0,0,16,0" />
                    <StackPanel>
                        <TextBlock Text="Питомцы" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Практическая работа № 7 · клиент REST API" Foreground="#C5DBD6" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" Padding="28,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сервер API" VerticalAlignment="Center" Margin="0,0,18,0" FontWeight="SemiBold" />
                <TextBox Grid.Column="1" Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsNotBusy}" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Адрес сервера, включая протокол и порт" />
                <Button Grid.Column="2" Content="Подключиться / обновить" Command="{Binding RefreshCommand}"
                        Margin="18,0,0,0" VerticalAlignment="Center" Padding="18,0" />
            </Grid>
        </Border>
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="4"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="3" Margin="24,20,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <materialDesign:Card Padding="20" UniformCornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Фильтры" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <Grid IsEnabled="{Binding IsNotBusy}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="190" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding SpeciesFilter, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,14,0"
                                     materialDesign:HintAssist.Hint="Вид (как в базе API)" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AdoptionFilters}" DisplayMemberPath="Title"
                                      SelectedItem="{Binding SelectedAdoptionFilter}"
                                      materialDesign:HintAssist.Hint="Статус пристройства"
                                      VerticalContentAlignment="Center" />
                        </Grid>
                        <DockPanel Margin="0,16,0,0" LastChildFill="False">
                            <Button Content="Применить" Command="{Binding ApplyFiltersCommand}" Margin="0,0,10,0" />
                            <Button Content="Сбросить" Command="{Binding ResetFiltersCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" />
                        </DockPanel>
                        <TextBlock Text="{Binding FilterSummary}" FontSize="12" Foreground="#5C7070" Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="2" Padding="18" UniformCornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Список питомцев" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding LookupId, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsNotBusy}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="ID" Margin="8,0,10,0" />
                            <Button Grid.Column="2" Content="Получить по ID" Command="{Binding GetByIdCommand}"
                                    VerticalAlignment="Center" Padding="12,0" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid ItemsSource="{Binding Pets}" SelectedItem="{Binding SelectedPet, Mode=TwoWay}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                                      IsEnabled="{Binding IsNotBusy}" HeadersVisibility="Column"
                                      GridLinesVisibility="None" RowHeight="44" BorderThickness="0"
                                      HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45" />
                                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" MinWidth="80" />
                                    <DataGridTextColumn Header="Вид" Binding="{Binding Species}" Width="*" MinWidth="70" />
                                    <DataGridTextColumn Header="Лет" Binding="{Binding Age}" Width="50" />
                                    <DataGridTextColumn Header="Вес, кг" Binding="{Binding Weight, StringFormat={}{0:0.##}}" Width="80" />
                                    <DataGridTextColumn Header="Статус" Binding="{Binding AdoptionStatus}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Список пуст. Измените фильтры или создайте питомца."
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="#657A78" MaxWidth="300" TextAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Pets.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding RecordCount}" Foreground="#657A78" FontSize="12" Margin="0,12,0,0" />
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <materialDesign:Card Grid.Column="2" Padding="22" UniformCornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Новая" Command="{Binding NewRecordCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="10,0" />
                            <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="Выберите запись в списке или заполните новую."
                                   TextWrapping="Wrap" Foreground="#657A78" FontSize="12" Margin="0,0,0,24" />
                        <StackPanel IsEnabled="{Binding IsNotBusy}">
                            <TextBox Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Style="{StaticResource FormField}" materialDesign:HintAssist.Hint="Имя питомца" />
                            <TextBox Text="{Binding Editor.Species, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                     Style="{StaticResource FormField}" materialDesign:HintAssist.Hint="Вид питомца" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Editor.Age, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource FormField}" materialDesign:HintAssist.Hint="Возраст, лет" />
                                <TextBox Grid.Column="2" Text="{Binding Editor.Weight, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                         Style="{StaticResource FormField}" materialDesign:HintAssist.Hint="Вес, кг" />
                            </Grid>
                            <CheckBox Content="Питомец уже пристроен" IsChecked="{Binding Editor.IsAdopted}"
                                      Margin="0,0,0,24" />
                        </StackPanel>
                        <Button Content="Создать питомца" Command="{Binding CreateCommand}" Margin="0,0,0,12"
                                Visibility="{Binding IsCreating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="Сохранить полностью (PUT)" Command="{Binding UpdateCommand}" Margin="0,0,0,12" />
                            <Button Content="Только изменения (PATCH)" Command="{Binding PatchCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,12" />
                            <TextBlock Text="PATCH отправляет только поля, изменённые в форме."
                                       TextWrapping="Wrap" Foreground="#657A78" FontSize="12" Margin="0,0,0,16" />
                            <Separator Margin="0,0,0,12" />
                            <Button Content="Удалить питомца" Command="{Binding DeleteCommand}"
                                    Foreground="#B3261E" Style="{StaticResource MaterialDesignFlatButton}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>

        <StackPanel Grid.Row="4" Margin="24,0,24,18">
            <Border Background="#FCEAE8" CornerRadius="8" Padding="14,10" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#92251E" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#526967" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
