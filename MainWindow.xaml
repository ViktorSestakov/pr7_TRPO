<Window x:Class="pr7_shestakov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr7_shestakov"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Button x:Name="Create" Content="Создать" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Click="Create_Click"/>
            <Button x:Name="Change" Content="Изменить" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2" Click="Change_Click"/>
            <Button x:Name="Del" Content="Удалить" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="3" Click="Del_Click"/>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>
            
            <!-- Filter -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Загатовка под фильтрацию" Grid.Column="0"></Label> <!-- TODO -->
                <Button Content="Применить" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1"/>
                <Button Content="Убрать" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2"/>
            </Grid>
            
            <!-- Show items -->
            <ListView Grid.Row="1">
                <!-- TODO -->
            </ListView>
        </Grid>
    </Grid>
</Window>
